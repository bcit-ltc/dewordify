{
  "name": "dewordify",
  "version": "1.0.0",
  "type": "module",
  "description": "Dewordify is used to facilitate the development of online course materials by converting MS Word documents into HTML pages.",
  "main": "index.js",
  "bin": {
    "dewordify": "./bin/dewordify",
    "munch": "./bin/munch",
    "estimate": "./bin/estimate",
    "strip": "./bin/strip"
  },
  "scripts": {
    "update": "git pull && npm install -g",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dewordify": "node bin/dewordify",
    "munch": "node bin/munch",
    "estimate": "node bin/estimate",
    "strip": "node bin/strip"
  },
  "author": {
    "name": "Mike Taylor"
  },
  "maintainer": "courseproduction@bcit.ca",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "cheerio": "^1.1.2",
    "js-beautify": "^1.15.4",
    "mammoth": "^1.11.0"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "globals": "^16.5.0"
  }
